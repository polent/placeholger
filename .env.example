# SFTP Deployment Configuration for placeholger.hellinger.wtf
# Copy this file to .env and fill in your SFTP credentials for local deployment (npm run deploy)

SFTP_HOST=placeholger.hellinger.wtf
SFTP_PORT=22
SFTP_USER=your_sftp_username
SFTP_REMOTE_DIR=/var/www/placeholger

# Authentication: Provide EITHER SFTP_SSH_KEY (path to private key) OR SFTP_PASSWORD
SFTP_SSH_KEY=~/.ssh/id_ed25519
SFTP_PASSWORD=
