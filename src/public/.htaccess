# placeholger.hellinger.wtf — Apache Production Configuration (.htaccess)
# Enforces Zero-Disk SVG Routing, Immutable Edge Caching, Compression, CORS, and Image Non-Indexing.

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to existing static files (.css, .js, .txt, .json, .xml, .woff2, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all dynamic placeholder paths (e.g. /600/400/9e9ea0/ffffff?text=...) to api.php
    RewriteRule ^(.+)$ api.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # Global Security & CORS headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"

    # Ensure static assets and JS SDK are cached aggressively
    <FilesMatch "\.(css|js|woff2|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Ensure AI / Agentic discovery manifests are easily readable with CORS
    <FilesMatch "(llms\.txt|llms-full\.txt|openapi\.json|ai-plugin\.json|robots\.txt|sitemap\.xml)$">
        Header set Cache-Control "public, max-age=3600"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# Enable Gzip / Brotli Compression for ultra-fast SVG, HTML, CSS, JS, and JSON delivery
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
